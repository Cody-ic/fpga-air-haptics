// Tang Mega 60K 物理约束（引脚绑定）
// 板卡：Sipeed Tang Mega 60K（FPGA 型号 GW5AT-LV60PG484A，Device Version B）
// 顶层模块：board_top
//
// 引脚号全部来自 Sipeed 官方例程（github.com/sipeed/TangMega-60K-example）：
//   - 时钟 V22、50 MHz：官方 sdc 里写的是 create_clock ... -period 20
//   - 按键 AA13 / AB13 / Y12：官方 cst 里 key0 / key1 / rst_n，都注明「内部上拉」
//   - 状态灯与两个 PMOD：官方 pmod_led.cst
//   - 相机口各脚：官方 NEO_DOCK.cst（我们不用相机，这些脚空着）
//
// ⚠️ 两处必须自己确认（板子到手后 5 分钟就能确认）：
//   1. 串口：板载 FT2232 的 UART 到底接哪两个 FPGA 引脚，官方「全引脚约束」表里才有，
//      网上没有公开文本。下面先用相机口两个空闲脚外接 USB-TTL 调通（能跑，但不漂亮）。
//      拿到官方表以后，把 uart_rx_pin / uart_tx_pin 换成板载串口的两个脚即可。
//   2. 通道：16 路输出暂时绑在两个 PMOD 上（正好 16 个脚）。其中 5 个脚同时接着板载
//      状态灯 —— 驱动 40 kHz 时那几个灯会微弱发亮，无害但费一点电。等驱动板定型，
//      按实际原理图重排这一节就行。

// ==================== 时钟 ====================
IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ==================== 按键（低有效，需要内部上拉：底板上没有上拉电阻）====================
IO_LOC  "key_rst_n" Y12;
IO_PORT "key_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC  "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC  "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// 第三个键（停止）暂时借用相机口的空闲脚；不接也行，PLAY 键本身就能暂停。
IO_LOC  "key2_n" AB20;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ==================== 串口（电脑 ↔ 板子）====================
// ⚠️ 待核实：这两行现在是「相机口外接 USB-TTL」的临时方案（相机口我们不用）。
//    板载 FT2232 的 UART 引脚请照官方全引脚约束表填。TX/RX 别接反：
//    电脑的 TX → 板子的 uart_rx_pin，电脑的 RX → 板子的 uart_tx_pin。
IO_LOC  "uart_rx_pin" Y13;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "uart_tx_pin" AA14;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ==================== 16 路输出（4×4，临时绑在两个 PMOD 上）====================
// 左边 PMOD（靠近板子左边缘）。注意：其中 5 个脚同时接着板载状态灯。
IO_LOC  "array_pos[0]"  P19;
IO_PORT "array_pos[0]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[1]"  R19;
IO_PORT "array_pos[1]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[2]"  T21;
IO_PORT "array_pos[2]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[3]"  U21;   // 与板载 state_led[4] 同脚
IO_PORT "array_pos[3]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[4]"  P16;   // 与板载 state_led[3] 同脚
IO_PORT "array_pos[4]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[5]"  R17;   // 与板载 state_led[2] 同脚
IO_PORT "array_pos[5]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[6]"  R18;   // 与板载 state_led[1] 同脚
IO_PORT "array_pos[6]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[7]"  T18;   // 与板载 state_led[0] 同脚
IO_PORT "array_pos[7]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 相机口那 8 个数据脚（我们不用相机，正好当另外 8 路输出）
IO_LOC  "array_pos[8]"  AA20;
IO_PORT "array_pos[8]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[9]"  AA19;
IO_PORT "array_pos[9]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[10]" T20;
IO_PORT "array_pos[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[11]" N15;
IO_PORT "array_pos[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[12]" R14;
IO_PORT "array_pos[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[13]" R16;
IO_PORT "array_pos[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[14]" P15;
IO_PORT "array_pos[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "array_pos[15]" P14;
IO_PORT "array_pos[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 互补输出（半桥驱动才用）：board_top 现在**故意不引出** array_neg——顶层端口没约束时
// 工具会把它们自动摆到随便哪个脚上，可能撞到 DDR/HDMI 那些不能乱动的脚。
// 要半桥方案时：把 board_top 里那行端口改成同时引出 array_pos/array_neg，
// 再在这里给 array_neg[0..15] 分配一组自己的引脚（不能和上面的通道重脚）。

// ==================== 状态灯（借用相机口剩下的脚）====================
IO_LOC  "led[0]" AA21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[1]" Y22;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[2]" AB22;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[3]" Y21;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[4]" AB21;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
